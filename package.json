{
  "name": "pi-jev-harness",
  "version": "0.3.1",
  "description": "Pure Jev System-One harness for Pi — pi-model tool-based calibrate + plan + git, zero deps, no fallback",
  "type": "module",
  "main": "src/index.ts",
  "files": ["src", "dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "keywords": ["pi", "pi-extension", "pi-package", "jev", "typesafe", "harness", "system-one", "agent"],
  "license": "MIT",
  "author": "Danu28",
  "repository": { "type": "git", "url": "https://github.com/Danu28/pi-jev-harness.git" },
  "homepage": "https://github.com/Danu28/pi-jev-harness#readme",
  "bugs": { "url": "https://github.com/Danu28/pi-jev-harness/issues" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "prettier": "^3.3.0"
  },
  "pi": { "extensions": ["src/index.ts"] }
}
